# Application
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production refuses the placeholder / short keys.
SECRET_KEY=change-this-to-a-random-secret-key-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# API
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./artifacts/app.db

# Storage
UPLOAD_DIR=data/uploads
FRAMES_DIR=data/frames
ARTIFACTS_DIR=artifacts
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=600
RETAIN_RAW_VIDEO=false

# Video processing
FRAME_SAMPLE_FPS=2
MAX_FRAMES_PER_VIDEO=150
FRAME_HEIGHT=112
FRAME_WIDTH=112
SEQUENCE_LENGTH=30

# Target tracking / crops
TRACKING_FPS=10
MIN_TRACKED_FRAMES=5
# Keep false: after a loss the remaining frames are marked invalid instead of risking a switch to another person
TRACK_ALLOW_REACQUISITION=false
TRACK_MIN_SIMILARITY=0.30
TRACK_RESUME_SIMILARITY=0.45
TRACK_MAX_JUMP_RATIO=1.0
TRACK_MAX_AREA_RATIO=3.0
MIN_BOX_PX=8
CROP_CONTEXT_PAD=0.10

# CNN
CNN_BACKBONE=simple_cnn
CNN_FEATURE_DIM=256
CNN_PRETRAINED=false

# LSTM
LSTM_HIDDEN_DIM=128
LSTM_NUM_LAYERS=2
LSTM_DROPOUT=0.3

# Fusion
FUSION_OUTPUT_DIM=64

# Quantum
QUANTUM_N_QUBITS=4
QAOA_DEPTH=2
VQC_DEPTH=3
QUANTUM_BACKEND=default.qubit
QUANTUM_SHOTS=1024
QUANTUM_ANALYTIC=true

# Labels (JSON list; length must equal NUM_CLASSES)
CLASS_NAMES=["Low","Moderate","High"]
NUM_CLASSES=3

# Model-use policy: leave false. Checkpoints trained on synthetic/test data are refused for real video.
ALLOW_SYNTHETIC_MODEL_INFERENCE=false

# Training
BATCH_SIZE=8
LEARNING_RATE=0.001
NUM_EPOCHS=10
RANDOM_SEED=42

# Federated
FED_ROUNDS=5
FED_CLIENTS=3
FED_LOCAL_EPOCHS=2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
